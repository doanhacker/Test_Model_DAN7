# Backend services (local Docker Compose defaults)
ELASTICSEARCH_URL=http://127.0.0.1:9200
QDRANT_URL=http://127.0.0.1:6333

# Optional: absolute path to snapshots, jobs, indexes and reports.
# When omitted, defaults to benchmark/runtime.
# BENCHMARK_DATA_DIR=C:/Users/Win 11/Test_Model_DAN7/Test_Model_DAN7/benchmark/runtime
# PostgreSQL server. Set a private password before docker compose up.
POSTGRES_DB=benchmark
POSTGRES_USER=benchmark
POSTGRES_PASSWORD=replace-with-a-private-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://benchmark:replace-with-a-private-password@127.0.0.1:5432/benchmark

# Optional: Qdrant embedded storage for software tests only.
# Leave unset to use the Qdrant server above.
# QDRANT_LOCAL_PATH=

# Image-to-image retrieval upload limits (JPEG/PNG/WEBP).
IMAGE_MAX_UPLOAD_MB=20
IMAGE_MAX_BATCH_MB=100
IMAGE_MAX_PIXELS=25000000
IMAGE_CPU_THREADS=4
# Optional: comma-separated HTTPS image hosts allowed for imported place photos.
# PLACE_IMAGE_ALLOWED_HOSTS=lh3.googleusercontent.com,streetviewpixels-pa.googleapis.com,photos.hotelbeds.com,images.trvl-media.com,dynamic-media-cdn.tripadvisor.com,cdn.worldota.net,cdn.ostrovok.ru,d2hyz2bfif3cr8.cloudfront.net
# Hugging Face per-download/read timeouts in seconds.
HF_HUB_DOWNLOAD_TIMEOUT=120
HF_HUB_ETAG_TIMEOUT=30
# Optional absolute directory for vision checkpoint snapshots (no symlink needed).
# IMAGE_MODEL_CACHE_DIR=C:/path/to/image_model_cache
